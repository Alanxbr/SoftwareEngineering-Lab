digraph jiegou {
  graph [rankdir=TB, splines=spline, nodesep=0.45, ranksep=0.62,
         fontname="Microsoft YaHei", fontsize=12, pad=0.25, charset="UTF-8"];
  node  [fontname="Microsoft YaHei", fontsize=11, shape=plaintext];
  edge  [fontname="Microsoft YaHei", fontsize=10, color="#333333", penwidth=1.1,
         arrowsize=0.8];

  PL [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="6" CELLPADDING="3" COLOR="#333333">
      <TR><TD COLSPAN="5"><B>表现层（Vue.js）</B></TD></TR>
      <TR>
        <TD>登录注册页</TD><TD>数据集管理页</TD><TD>训练任务页</TD>
        <TD>训练监控与结果页</TD><TD>系统管理页</TD>
      </TR>
    </TABLE>>];

  IL [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="6" CELLPADDING="3" COLOR="#333333">
      <TR><TD COLSPAN="2"><B>接口层（FastAPI）</B></TD></TR>
      <TR><TD>REST API 路由</TD><TD>JWT 身份认证</TD></TR>
    </TABLE>>];

  BL [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="6" CELLPADDING="3" COLOR="#333333">
      <TR><TD COLSPAN="6"><B>业务逻辑层</B></TD></TR>
      <TR>
        <TD>用户服务</TD><TD>数据服务</TD><TD>训练服务</TD>
        <TD>隐私服务</TD><TD>结果展示服务</TD><TD>管理服务</TD>
      </TR>
    </TABLE>>];

  DL [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="6" CELLPADDING="3" COLOR="#333333">
      <TR><TD COLSPAN="2"><B>数据访问层</B></TD></TR>
      <TR><TD>业务数据 DAO（SQLite）</TD><TD>模型文件存储</TD></TR>
    </TABLE>>];

  FL [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="4" CELLPADDING="3" COLOR="#333333">
      <TR><TD COLSPAN="2"><B>联邦训练子系统</B></TD></TR>
      <TR><TD>Flower 协调服务</TD><TD>参与方客户端</TD></TR>
      <TR><TD>PyTorch 训练器</TD><TD>差分隐私模块</TD></TR>
    </TABLE>>];

  LOCAL [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="6" CELLPADDING="3" COLOR="#666666" BGCOLOR="#F2F2F2">
      <TR><TD>参与方本地原始数据（不上传）</TD></TR>
    </TABLE>>];

  PL -> IL [label=" HTTP/HTTPS "];
  IL -> BL [label=" 调用业务服务 "];
  BL -> DL [label=" 读写业务数据 "];
  BL -> FL [label=" 下发训练配置\n回收训练结果 "];
  FL -> LOCAL [label=" 原始数据不出本地 ", dir=back, style=dashed];
  FL -> DL [label=" 保存模型参数文件 ", style=dashed];
}
