    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="4" CELLPADDING="3" COLOR="#333333">
      <TR><TD COLSPAN="2" BGCOLOR="#E6E6E6"><B>xitong_rizhi 系统日志</B></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">caozuozhe_id → yonghu.id</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">caozuo_leixing</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">duixiang_leixing</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">duixiang_id</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">jieguo</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">rizhi_shijian</TD></TR>
    </TABLE>>];

  yonghu -> shujuji [label="1 : N\n登记"];
  yonghu -> xunlian_renwu [label="1 : N\n创建"];
  yonghu -> renwu_canjiafang [label="1 : N\n参与"];
  shujuji -> renwu_canjiafang [label="1 : N\n授权使用"];
  xunlian_renwu -> renwu_canjiafang [label="1 : N\n包含"];
  xunlian_renwu -> lunci_jilu [label="1 : N\n产生"];
  xunlian_renwu -> yinsi_yusuan [label="1 : N\n记录"];
  yonghu -> xitong_rizhi [label="1 : N\n产生"];
}
