    </TABLE>>];

  yinsi_yusuan [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="4" CELLPADDING="3" COLOR="#333333">
      <TR><TD COLSPAN="2" BGCOLOR="#E6E6E6"><B>yinsi_yusuan 隐私预算</B></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">renwu_id → xunlian_renwu.id</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">lunci_hao</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">benlun_eps</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">leiji_eps</TD></TR>
